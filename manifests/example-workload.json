{
  "apiVersion": "omnimesh.io/v1alpha1",
  "kind": "Workload",
  "metadata": {
    "name": "hello",
    "tenant": "local",
    "generation": 1
  },
  "spec": {
    "image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "command": ["/bin/echo", "hello"],
    "replicas": 2,
    "resources": {"cpuMillis": 1000, "memoryBytes": 134217728},
    "platform": {"os": "linux", "architecture": "amd64"},
    "runtime": "oci",
    "nodeSelector": {"site": "local"},
    "privileged": false,
    "capabilities": [],
    "retry": {"maxAttempts": 1, "backoffMillis": 1000}
  }
}
